{
  "name": "@crit-fumble/react",
  "version": "0.2.1",
  "type": "module",
  "description": "Light, self-styled React components shared across PlayTable (Next.js) and JS-only surfaces (the FoundryVTT plugin). Pure UI — no three.js, no @crit-fumble/shared runtime dep; the host wires behaviour via props.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crit-Fumble/cfg-react.git"
  },
  "homepage": "https://github.com/Crit-Fumble/cfg-react",
  "bugs": "https://github.com/Crit-Fumble/cfg-react/issues",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "test": "jest --config jest.config.cjs",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.2",
    "typescript": "^6.0.3"
  }
}
